{
    "manifest_version": 3,
    "name": "RecruitAI - LinkedIn Connector",
    "version": "1.1.0",
    "description": "Seamlessly save LinkedIn profiles to your RecruitAI CRM with one click.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs"
    ],
    "externally_connectable": {
        "matches": [
            "http://localhost:3000/*",
            "https://ai-recruit-eight.vercel.app/*"
        ]
    },
    "host_permissions": [
        "*://*.linkedin.com/*",
        "*://linkedin.com/*",
        "http://localhost:8089/*",
        "https://ai-recruit-eight.vercel.app/*",
        "https://recruitai-backend-bvo0.onrender.com/*",
        "https://*.onrender.com/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "RecruitAI LinkedIn Connector",
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "scripts/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.linkedin.com/in/*",
                "*://linkedin.com/in/*",
                "*://*.linkedin.com/in",
                "*://linkedin.com/in"
            ],
            "js": [
                "scripts/content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}