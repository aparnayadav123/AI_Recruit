# ── Frontend (Vite) ──────────────────────────────────────────────
VITE_API_URL=http://localhost:8089/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_OUTLOOK_CLIENT_ID=your-azure-app-client-id
VITE_REDIRECT_URI=http://localhost:3000/login

# ── AI (optional) ────────────────────────────────────────────────
# Leave blank to use the built-in deterministic parser (app still works).
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Backend secrets (set as environment variables, NOT in code) ──
# MongoDB defaults to mongodb://localhost:27017 (see application.properties).
# Zoom (optional — blank = free Jitsi meeting links):
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# SMTP (optional — email sending is currently disabled in the app):
MAIL_USERNAME=
MAIL_PASSWORD=
